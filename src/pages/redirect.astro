---
import Layout from '@/layouts/Layout.astro'

const delay = 5
---

<Layout title="即将离开本站" noindex>
  <main
    id="redirect"
    data-delay={delay}
    data-pagefind-ignore
    class="min-h-screen flex items-center justify-center px-4 py-16"
  >
    <div
      class="w-full max-w-[520px] rounded-2xl border border-primary bg-secondary p-8 text-center"
    >
      <i class="iconfont icon-external-link text-4xl text-accent"></i>
      <h1 class="mt-4 text-2xl font-bold">即将离开本站</h1>
      <p class="mt-2 text-secondary">你即将前往外部网站，请注意甄别内容与财产安全。</p>

      <p
        id="target"
        class="mt-4 break-all rounded-lg bg-primary px-3 py-2 text-left text-sm text-secondary"
      >
        正在解析链接…
      </p>

      <p class="mt-5 text-secondary">
        <span id="countdown" class="text-3xl font-bold tabular-nums text-accent">{delay}</span>
        <span class="ml-1">秒后自动跳转</span>
      </p>

      <div class="mt-6 flex justify-center gap-3">
        <a
          id="go"
          href="#"
          data-no-redirect
          class="rounded-full bg-accent px-6 py-2 text-white transition-opacity hover:opacity-90"
        >
          立即前往
        </a>
        <button
          id="back"
          type="button"
          class="rounded-full border border-primary px-6 py-2 transition-colors hover:border-accent hover:text-accent"
        >
          返回
        </button>
      </div>
    </div>
  </main>

  <script>
    const root = document.getElementById('redirect') as HTMLElement
    const delay = Number(root.dataset.delay) || 5
    const targetEl = document.getElementById('target') as HTMLElement
    const countdownEl = document.getElementById('countdown') as HTMLElement
    const goEl = document.getElementById('go') as HTMLAnchorElement
    const backEl = document.getElementById('back') as HTMLButtonElement

    let target: string | null = null
    try {
      const url = new URL(new URLSearchParams(location.search).get('url') ?? '')
      if (url.protocol === 'http:' || url.protocol === 'https:') target = url.href
    } catch {
      // 参数缺失或非法，保持 target 为空
    }

    if (target) {
      const href = target
      targetEl.textContent = href
      goEl.href = href
      goEl.addEventListener('click', (event) => {
        event.preventDefault()
        location.replace(href)
      })

      let remaining = delay
      const timer = setInterval(() => {
        remaining -= 1
        countdownEl.textContent = String(Math.max(remaining, 0))
        if (remaining <= 0) {
          clearInterval(timer)
          location.replace(href)
        }
      }, 1000)
    } else {
      targetEl.textContent = '链接无效，无法跳转。'
      countdownEl.textContent = '—'
      goEl.setAttribute('aria-disabled', 'true')
      goEl.addEventListener('click', (event) => event.preventDefault())
    }

    backEl.addEventListener('click', () => {
      if (history.length > 1) history.back()
      else location.href = '/'
    })
  </script>
</Layout>
